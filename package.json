{
  "name": "dsh-expert-bridge",
  "version": "0.2.0",
  "private": true,
  "description": "DSH plugin: ask a stronger expert model about a stuck problem (sync), dispatch low/medium tier subagents for chores, and nudge long-tail tool loops. Settings page included.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "engines": {
    "dsh": ">=0.2.0",
    "node": ">=22.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "files": [
    "src",
    "docs",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Soul-Charge/dsh-tiered-workflow.git"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  }
}
