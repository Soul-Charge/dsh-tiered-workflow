{
  "name": "dsh-tiered-workflow",
  "version": "0.3.1",
  "private": true,
  "description": "DSH plugin (dsh-tiered-workflow): tiered multi-model workflow with model x reasoningEffort profiles, continuable readonly planner, fresh reviewer, host-level hard gates, 6-field token metrics, ExternalBackendAdapter v1 port, and Web settings GUI.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "engines": {
    "dsh": ">=0.2.0",
    "node": ">=22.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "files": [
    "src",
    "docs",
    "presets",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/unit.test.mjs",
    "test:integration": "node --test test/dsh-integration.test.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Soul-Charge/dsh-tiered-workflow.git"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  }
}
